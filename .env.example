# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public base URL of the app, with no trailing slash.
# Local development: http://localhost:3000
# On Vercel, leave it unset: the production domain is picked up automatically.
APP_URL=http://localhost:3000

# PostgreSQL connection string.
# Neon (free): copy the pooled connection string from the Neon dashboard.
# Local Postgres: postgres://USER:PASSWORD@localhost:5432/touchpoint
DATABASE_URL=

# Secret used to sign sessions. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Bearer token the scheduler sends to POST /api/jobs/tick. At least 32 characters.
# Generate one the same way as AUTH_SECRET, and use a different value.
CRON_SECRET=

# Optional. Key that encrypts what Google Calendar needs (your OAuth client's secret and
# the access Google grants) before it is stored. At least 32 characters; generate it the
# same way as AUTH_SECRET. Without it, Settings > Integrations explains how to set it and
# offers nothing else. A new key means entering the client again and reconnecting.
# Give previews a different value from production.
APP_ENCRYPTION_KEY=

# Optional. Google won't publish your OAuth client until you prove you run this site.
# In Google Search Console, add a URL-prefix property for APP_URL, pick "HTML tag", and
# paste only the content="..." value here. Every page then carries that tag.
GOOGLE_SITE_VERIFICATION=

# Optional. An address shown on the public /privacy page for questions about your data.
CONTACT_EMAIL=

# Optional. Some company websites send an empty page and build it in the browser.
# To read those, the address of that page is sent to Jina Reader (https://r.jina.ai,
# free, no key), which answers with the page as drawn. Set to "off" to never do this;
# such sites then give only their description and logo.
WEBSITE_RENDERER=jina

# Optional. Keeps a brainstorm board in step across your devices at once, through a small
# room of your own on Cloudflare's free plan (see live-room/README.md). Set both, with
# APP_ENCRYPTION_KEY above; without them a board asks the server for changes every 10 seconds.
# LIVE_ROOM_URL looks like wss://touchpoint-live-room.YOURNAME.workers.dev, with no trailing slash.
# LIVE_ROOM_SECRET is at least 32 characters, generated the same way as AUTH_SECRET.
LIVE_ROOM_URL=
LIVE_ROOM_SECRET=

# Optional. With a key from Tavily (https://tavily.com, free tier of 1,000 searches a
# month), a person's panel offers "Find profile links": their name and one company name
# are sent to Tavily to look for their LinkedIn, X and GitHub profiles, and what comes
# back is offered for you to add. Leave it blank and the button is not shown.
TAVILY_API_KEY=

# Optional, for running tests only: a separate disposable database.
# Its tables are emptied on every test run, so never point this at real data.
TEST_DATABASE_URL=
