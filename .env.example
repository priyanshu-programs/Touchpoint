# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public base URL of the app, with no trailing slash.
# Local development: http://localhost:3000
# On Vercel, leave it unset: the production domain is picked up automatically.
APP_URL=http://localhost:3000

# PostgreSQL connection string.
# Neon (free): copy the pooled connection string from the Neon dashboard.
# Local Postgres: postgres://USER:PASSWORD@localhost:5432/touchpoint
DATABASE_URL=

# Secret used to sign sessions. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Bearer token the scheduler sends to POST /api/jobs/tick. At least 32 characters.
# Generate one the same way as AUTH_SECRET, and use a different value.
CRON_SECRET=

# Optional. Some company websites send an empty page and build it in the browser.
# To read those, the address of that page is sent to Jina Reader (https://r.jina.ai,
# free, no key), which answers with the page as drawn. Set to "off" to never do this;
# such sites then give only their description and logo.
WEBSITE_RENDERER=jina

# Optional, for running tests only: a separate disposable database.
# Its tables are emptied on every test run, so never point this at real data.
TEST_DATABASE_URL=
